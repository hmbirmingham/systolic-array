# Local-only context — stays on my machine, never committed
CLAUDE.md
PRIVATE_LOG.md
ROADMAP.local.md

# Python
.venv/
__pycache__/
*.py[cod]

# cocotb / simulation artifacts
sim_build/
results.xml
*.vcd
*.fst
*.fst.hier
*.ghw

# Yosys / nextpnr intermediates. Scoped to synth/build so a stray *.json
# rule can never silently swallow a config file elsewhere in the repo.
synth/build/
*.asc
*.bin
*.blif

# macOS
.DS_Store
bench/mcu/host_check
bench/mcu/*.elf
bench/mcu/*.bin
bench/mcu/*.map

# nextpnr JSON reports are intermediate; the .txt beside them is the record
# and synth/pnr.sh regenerates both.
synth/reports/*.json
